{
  "name": "nexus-marketing-intelligence-pwa",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "dev:api": "tsx watch server/src/index.ts",
    "start:api": "node server/dist/index.js",
    "build:server": "tsc -p server/tsconfig.json",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "db:migrate": "tsx server/src/migrate.ts",
    "test:server": "tsx --test server/test/token-vault.test.ts server/test/normalization.test.ts server/test/config.test.ts server/test/invitation-token.test.ts server/test/auth-cookies.test.ts server/test/auth-middleware.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^10.2.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.4.5",
    "@vitejs/plugin-react": "^4.3.4"
  }
}
