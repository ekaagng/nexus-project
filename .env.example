# Frontend. Never put provider secrets in VITE_* variables.
VITE_API_BASE_URL=http://localhost:8787

# API runtime (sample credentials are for local development only)
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=8787
DATABASE_URL=postgresql://nexus_app:nexus_app@localhost:5432/nexus
# Required schema-owner connection, used only by npm run db:migrate.
MIGRATION_DATABASE_URL=postgresql://nexus_migrator:nexus_migrator@localhost:5432/nexus
DATABASE_SSL=false
CORS_ORIGINS=http://localhost:5173

# OIDC API token verification.
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

# Browser Authorization Code + PKCE. Register this callback URL with the provider.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Use client_secret_basic, client_secret_post, or none for a public PKCE client.
OIDC_CLIENT_AUTH_METHOD=client_secret_basic
OIDC_REDIRECT_URI=http://localhost:8787/api/v1/auth/oidc/callback
AUTH_FRONTEND_URL=http://localhost:5173
AUTH_SESSION_TTL_SECONDS=43200
SESSION_COOKIE_SECURE=false

# Base64-encoded 32-byte key. Required for encrypted PKCE transactions and
# production operation. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
