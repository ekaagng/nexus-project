# Frontend. Never put provider secrets in VITE_* variables.
VITE_API_BASE_URL=http://localhost:8787

# API runtime
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=8787
DATABASE_URL=postgresql://nexus_app:nexus_app@localhost:5432/nexus
# Optional schema-owner connection, used only by npm run db:migrate.
MIGRATION_DATABASE_URL=postgresql://nexus_migrator:nexus_migrator@localhost:5432/nexus
DATABASE_SSL=false
CORS_ORIGINS=http://localhost:5173

# Configure all three values together before enabling authenticated routes.
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

# Base64-encoded 32-byte key. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
